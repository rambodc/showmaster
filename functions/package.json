{
  "name": "showmaster-functions",
  "description": "Cloud Functions for the Showmaster starter",
  "private": true,
  "type": "module",
  "main": "index.js",
  "engines": { "node": "20" },
  "scripts": {
    "test": "node --test",
    "check": "find . -path './node_modules' -prune -o -name '*.js' -type f -exec node --check {} +",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^12.5.0",
    "firebase-functions": "^5.1.1"
  }
}
