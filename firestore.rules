rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function showPath(showId) {
      return /databases/$(database)/documents/shows/$(showId);
    }

    function managerPath(showId, uid) {
      return /databases/$(database)/documents/shows/$(showId)/managers/$(uid);
    }

    function userShowAccessPath(showId, uid) {
      return /databases/$(database)/documents/users/$(uid)/showAccess/$(showId);
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isSuperAdmin() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.systemRole == 'super_admin';
    }

    function isShowOwner(showId) {
      return signedIn()
        && exists(showPath(showId))
        && get(showPath(showId)).data.ownerId == request.auth.uid;
    }

    function isShowManager(showId) {
      return signedIn() && exists(managerPath(showId, request.auth.uid));
    }

    function isShowMember(showId) {
      return signedIn() && exists(userShowAccessPath(showId, request.auth.uid));
    }

    function isShowAdmin(showId) {
      return isShowOwner(showId)
        || (
          isShowManager(showId)
          && get(managerPath(showId, request.auth.uid)).data.managerRole == 'full_manager'
        );
    }

    function canAccessShow(showId) {
      return isShowOwner(showId) || isShowManager(showId) || isShowMember(showId);
    }

    function managerHasFeature(showId, feature) {
      return isShowAdmin(showId)
        || (
          isShowManager(showId)
          && get(managerPath(showId, request.auth.uid)).data.featureAccess[feature] == true
        );
    }

    function managerCanAccessJob(showId, jobId) {
      return isShowAdmin(showId)
        || (
          isShowManager(showId)
          && get(managerPath(showId, request.auth.uid)).data.featureAccess.jobs == true
          && (
            get(managerPath(showId, request.auth.uid)).data.jobAccess.mode == 'all'
            || jobId in get(managerPath(showId, request.auth.uid)).data.jobAccess.jobIds
          )
        );
    }

    function jobMemberPath(showId, jobId, uid) {
      return /databases/$(database)/documents/shows/$(showId)/jobs/$(jobId)/members/$(uid);
    }

    function hasJobAccess(showId, jobId) {
      return managerCanAccessJob(showId, jobId)
        || (signedIn() && exists(jobMemberPath(showId, jobId, request.auth.uid)));
    }

    function userCreateIsSafe(uid) {
      return request.resource.data.uid == uid
        && request.resource.data.systemRole == 'user';
    }

    function userUpdateIsSafe() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'systemRole',
        'primaryAuthUid',
        'uid'
      ]);
    }

    match /users/{uid} {
      allow get: if isSelf(uid) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isSelf(uid) && userCreateIsSafe(uid);
      allow update: if isSuperAdmin() || (isSelf(uid) && userUpdateIsSafe());
      allow delete: if isSuperAdmin();

      match /showAccess/{showId} {
        allow read: if isSelf(uid) || isSuperAdmin();
        allow write: if isSuperAdmin();
      }

      match /jobAccess/{accessId} {
        allow read: if isSelf(uid) || isSuperAdmin();
        allow write: if isSuperAdmin();
      }
    }

    match /shows/{showId} {
      allow get: if canAccessShow(showId);
      allow list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();

      match /managers/{managerId} {
        allow get: if isSelf(managerId) || managerHasFeature(showId, 'managers');
        allow list: if managerHasFeature(showId, 'managers');
        allow write: if false;
      }

      match /jobs/{jobId} {
        allow get: if managerCanAccessJob(showId, jobId) || (signedIn() && exists(jobMemberPath(showId, jobId, request.auth.uid)));
        allow list: if managerHasFeature(showId, 'jobs') && (isShowAdmin(showId) || get(managerPath(showId, request.auth.uid)).data.jobAccess.mode == 'all');
        allow create: if managerHasFeature(showId, 'jobs');
        allow update, delete: if managerCanAccessJob(showId, jobId);

        match /members/{memberId} {
          allow read: if managerCanAccessJob(showId, jobId) || isSelf(memberId);
          allow write: if false;
        }

        match /messages/{messageId} {
          allow read: if hasJobAccess(showId, jobId);
          allow write: if false;
        }

        match /widgets/{widgetId} {
          allow read: if hasJobAccess(showId, jobId);
          allow write: if managerCanAccessJob(showId, jobId);

          match /contacts/{contactId} {
            allow read: if hasJobAccess(showId, jobId);
            allow write: if managerCanAccessJob(showId, jobId);
          }

          match /records/{recordId} {
            allow read: if hasJobAccess(showId, jobId);
            allow write: if managerCanAccessJob(showId, jobId);
          }
        }

        match /files/{fileId} {
          allow read: if hasJobAccess(showId, jobId);
          allow write: if false;
        }

        match /updates/{updateId} {
          allow read: if hasJobAccess(showId, jobId);
          allow write: if isShowAdmin(showId);
        }

        match /activity/{eventId} {
          allow read: if hasJobAccess(showId, jobId);
          allow write: if false;
        }
      }

      match /files/{fileId} {
        allow read, write: if isShowAdmin(showId);
      }

      match /updates/{updateId} {
        allow read, write: if isShowAdmin(showId);
      }

      match /activity/{eventId} {
        allow read: if isShowAdmin(showId);
        allow write: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
