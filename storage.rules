rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/(default)/documents/users/$(uid);
    }

    function showPath(showId) {
      return /databases/(default)/documents/shows/$(showId);
    }

    function managerPath(showId, uid) {
      return /databases/(default)/documents/shows/$(showId)/managers/$(uid);
    }

    function userShowAccessPath(showId, uid) {
      return /databases/(default)/documents/users/$(uid)/showAccess/$(showId);
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isSuperAdmin() {
      return signedIn()
        && firestore.exists(userPath(request.auth.uid))
        && firestore.get(userPath(request.auth.uid)).data.systemRole == 'super_admin';
    }

    function isShowOwner(showId) {
      return signedIn()
        && firestore.exists(showPath(showId))
        && firestore.get(showPath(showId)).data.ownerId == request.auth.uid;
    }

    function isShowManager(showId) {
      return signedIn() && firestore.exists(managerPath(showId, request.auth.uid));
    }

    function isShowMember(showId) {
      return signedIn() && firestore.exists(userShowAccessPath(showId, request.auth.uid));
    }

    function isShowAdmin(showId) {
      return isShowOwner(showId)
        || (
          isShowManager(showId)
          && firestore.get(managerPath(showId, request.auth.uid)).data.managerRole == 'full_manager'
        );
    }

    function canAccessShow(showId) {
      return isShowOwner(showId) || isShowManager(showId) || isShowMember(showId);
    }

    function managerCanAccessJob(showId, jobId) {
      return isShowAdmin(showId)
        || (
          isShowManager(showId)
          && firestore.get(managerPath(showId, request.auth.uid)).data.featureAccess.jobs == true
          && (
            firestore.get(managerPath(showId, request.auth.uid)).data.jobAccess.mode == 'all'
            || jobId in firestore.get(managerPath(showId, request.auth.uid)).data.jobAccess.jobIds
          )
        );
    }

    function jobMemberPath(showId, jobId, uid) {
      return /databases/(default)/documents/shows/$(showId)/jobs/$(jobId)/members/$(uid);
    }

    function hasJobAccess(showId, jobId) {
      return managerCanAccessJob(showId, jobId)
        || (signedIn() && firestore.exists(jobMemberPath(showId, jobId, request.auth.uid)));
    }

    match /users/{uid}/{fileName=**} {
      allow read: if signedIn();
      allow write: if isSelf(uid);
    }

    match /shows/{showId}/icons/{fileName=**} {
      allow read: if isSuperAdmin() || canAccessShow(showId);
      allow write: if isSuperAdmin() || isShowAdmin(showId);
    }

    match /shows/{showId}/files/{fileName=**} {
      allow read, write: if isShowAdmin(showId);
    }

    match /shows/{showId}/jobs/{jobId}/files/{fileName=**} {
      allow read, write: if managerCanAccessJob(showId, jobId);
    }

    match /shows/{showId}/jobs/{jobId}/message-files/{fileName=**} {
      allow read, write: if hasJobAccess(showId, jobId);
    }

    match /shows/{showId}/jobs/{jobId}/company-logo/{fileName=**} {
      allow read: if canAccessShow(showId);
      allow write: if managerCanAccessJob(showId, jobId);
    }

    match /shows/{showId}/ai3d-assets/{fileName=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
